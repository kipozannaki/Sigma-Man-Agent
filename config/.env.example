# ============================================================
# sigma-man-agent 环境配置模板
# 使用方法：复制为 config/.env 并填入真实值，严禁将真实 .env 提交至仓库
# ============================================================

# ---------- LLM 配置 ----------
# OpenAI 兼容接口的 API Key（占位符，替换为你自己的）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# LLM 基础地址（兼容 OpenAI 协议的中转/私有部署地址）
LLM_BASE_URL=https://api.openai.com/v1
# 对话主模型
LLM_MODEL=gpt-4o-mini
# 向量化模型（用于法条/心理语料入库）
EMBEDDING_MODEL=text-embedding-3-small

# ---------- 存储配置 ----------
# Redis（会话画像暂存，TTL 30分钟）
REDIS_URL=redis://localhost:6379/0
# PostgreSQL（pgvector / 埋点分析表 analytics）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sigma_man

# ---------- 向量库配置（二选一） ----------
# Pinecone 云端（不使用则留空）
PINECONE_API_KEY=
PINECONE_ENV=gcp-starter
# 本地 Chroma 持久化目录（默认走本地，零成本启动）
CHROMA_PERSIST_DIR=./data/vector_db

# ---------- 安全配置 ----------
# 画像脱敏加盐（用于会话ID哈希，替换为随机长字符串）
ENCRYPTION_SALT=CHANGE_ME_TO_RANDOM_32_BYTES
# 会话画像 TTL（秒），默认30分钟
PROFILE_TTL_SECONDS=1800
